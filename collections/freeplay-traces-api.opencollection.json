{
  "opencollection": "1.0.0",
  "info": {
    "name": "Freeplay HTTP Agents Traces API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Traces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Record a trace that groups related completions within a session.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.freeplay.ai/api/v2/projects/:project_id/sessions/:session_id/traces/id/:trace_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The Freeplay project ID."
              },
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "trace_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Record a trace that groups related completions within a session."
        }
      ]
    }
  ],
  "bundled": true
}